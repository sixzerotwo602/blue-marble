# ===================================
# Blue Marble Game Server Configuration
# ===================================
# Copy this file to .env and update values as needed

# Server Port
PORT=3001

# Node Environment (development | production | test)
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# WebSocket Configuration
WS_PING_INTERVAL=25000
WS_PING_TIMEOUT=60000

# Game Configuration
# Time limit options in minutes (comma-separated)
GAME_TIME_LIMITS=30,60,90

# Database (Future: PostgreSQL for game logging)
# DATABASE_URL=postgresql://user:password@localhost:5432/bluemarble

# Redis (Future: Session/Cache)
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
